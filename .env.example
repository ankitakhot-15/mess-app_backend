NODE_ENV=development
PORT=5000
CORS_ORIGINS=*

JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Customer OTP login (optional, turn on later)
OTP_ENABLED=false
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=5

# Razorpay (needs BOTH key id and key secret)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (needs cloud name + API key + API secret)
CLOUDINARY_CLOUD_NAME=onngxf4v
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (Firestore + FCM push). Download service account JSON from
# Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=messapp-bf5df
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# or: base64 of the JSON (for hosting platforms)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# First admin (used by: npm run seed)
ADMIN_NAME=Super Admin
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=ChangeMe@123
